<!-- MODALS -->
<div class="modal" id="modal-privacy"><button class="m-close" onclick="cMod('privacy')">✕</button><div class="m-inner"><div class="m-title">Privacy Policy</div><div class="m-sub">Last Updated: January 2024</div><div class="m-body"><h3>1. Information We Collect</h3><p>We collect information you provide directly — name, email, phone, delivery address, and payment information when placing orders or creating accounts.</p><h3>2. How We Use Your Information</h3><p>To process orders, send confirmations, provide customer support, send marketing communications (with consent), and improve our products and services.</p><h3>3. Cookies</h3><p>Our website uses cookies to enhance browsing, analyze traffic, and personalize content. You can control settings through your browser.</p><h3>4. Your Rights</h3><ul><li>Right to access your personal data</li><li>Right to correct inaccurate information</li><li>Right to request deletion of your data</li><li>Right to opt out of marketing communications</li></ul><h3>5. Contact</h3><p>For privacy concerns: privacy@DarkEmber.in or +91 98765 43210</p></div></div></div>

<div class="modal" id="modal-terms"><button class="m-close" onclick="cMod('terms')">✕</button><div class="m-inner"><div class="m-title">Terms & Conditions</div><div class="m-sub">Last Updated: January 2024</div><div class="m-body"><h3>1. Acceptance of Terms</h3><p>By accessing DarkEmber's website, you accept and agree to be bound by these Terms. If you do not agree, please do not use our website.</p><h3>2. Product Orders</h3><p>All orders are subject to product availability. We reserve the right to refuse or cancel orders. Payment must be received before orders are processed.</p><h3>3. Intellectual Property</h3><p>All content including text, graphics, logos, and images are the property of DarkEmber and protected by applicable IP laws.</p><h3>4. Governing Law</h3><p>These terms are governed by the laws of Maharashtra, India. Disputes shall be subject to courts in Pune.</p></div></div></div>

<div class="modal" id="modal-shipping"><button class="m-close" onclick="cMod('shipping')">✕</button><div class="m-inner"><div class="m-title">Shipping Policy</div><div class="m-sub">Last Updated: January 2024</div><div class="m-body"><h3>Processing Time</h3><p>All orders processed within 1-2 business days. Orders after 2pm IST processed the following day.</p><h3>Delivery Timelines</h3><ul><li>Pune: Same day / Next day available</li><li>Maharashtra: 2-3 business days</li><li>Pan India: 3-5 business days</li></ul><h3>Packaging</h3><p>All chocolates packed in temperature-controlled packaging to ensure integrity during transit.</p><h3>Charges</h3><p>Free shipping on orders above ₹1,500. Standard ₹99 below this threshold.</p></div></div></div>

<div class="modal" id="modal-refund"><button class="m-close" onclick="cMod('refund')">✕</button><div class="m-inner"><div class="m-title">Refund Policy</div><div class="m-sub">Last Updated: January 2024</div><div class="m-body"><h3>Return Eligibility</h3><p>Due to perishable nature, we accept returns only for damaged goods, incorrect items, or quality issues. Claims within 24 hours of delivery.</p><h3>How to Raise a Claim</h3><ul><li>Email hello@DarkEmber.in with your order number</li><li>Attach photographs of the damaged product</li></ul><h3>Resolution</h3><p>Claims reviewed within 24 hours. Refunds processed within 5-7 business days.</p></div></div></div>

<script>
// CURSOR
const cur=document.getElementById('cur'),curR=document.getElementById('cur-r');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px'});
(function aR(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;curR.style.left=rx+'px';curR.style.top=ry+'px';requestAnimationFrame(aR)})();
document.querySelectorAll('a,button,.cc,.p-card,.soc-link,.tc,.ig-cell,.mos-cell').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cur.style.transform='translate(-50%,-50%) scale(2)';curR.style.transform='translate(-50%,-50%) scale(1.5)';curR.style.borderColor='rgba(200,150,44,.85)'});
  el.addEventListener('mouseleave',()=>{cur.style.transform='translate(-50%,-50%) scale(1)';curR.style.transform='translate(-50%,-50%) scale(1)';curR.style.borderColor='rgba(200,150,44,.5)'});
});

// LOADER
window.addEventListener('load',()=>{setTimeout(()=>document.getElementById('load').classList.add('gone'),2300)});

// NAVBAR
const nb=document.getElementById('nb');
window.addEventListener('scroll',()=>nb.classList.toggle('s',window.scrollY>60));

// PROGRESS
window.addEventListener('scroll',()=>{const d=document.documentElement.scrollHeight-window.innerHeight;document.getElementById('prog').style.width=(window.scrollY/d*100)+'%'});

// REVEAL
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('on')}),{threshold:.1});
document.querySelectorAll('.rv').forEach(r=>obs.observe(r));

// MOBILE NAV
function tMnav(){document.getElementById('mnav').classList.toggle('open')}
function cMnav(){document.getElementById('mnav').classList.remove('open')}

// TESTIMONIALS
let ti=0;
const tt=document.getElementById('tt');
function vc(){const w=window.innerWidth;return w<768?1:w<1100?2:3}
function slide(d){const v=vc(),m=tt.children.length-v;ti=Math.max(0,Math.min(m,ti+d));const cw=tt.parentElement.offsetWidth/v;tt.style.transform=`translateX(-${ti*cw}px)`}
document.getElementById('tprev').onclick=()=>slide(-1);
document.getElementById('tnext').onclick=()=>slide(1);

// MODALS
function oMod(t){document.getElementById('modal-'+t).classList.add('on');document.body.style.overflow='hidden'}
function cMod(t){document.getElementById('modal-'+t).classList.remove('on');document.body.style.overflow=''}

// PARALLAX on pq-bg
window.addEventListener('scroll',()=>{const el=document.querySelector('.pq-bg');if(!el)return;const rect=el.parentElement.getBoundingClientRect();const offset=rect.top*0.3;el.style.transform=`translateY(${offset}px)`});

// FORM
function fSub(btn){btn.textContent='Message Sent ✓';btn.style.background='rgba(200,150,44,.25)';btn.style.color='var(--gold)';setTimeout(()=>{btn.textContent='Send Message';btn.style.background='var(--gold)';btn.style.color='var(--matte-black)'},3000)}
</script>
</body>
</html>
